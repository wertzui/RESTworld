{
    "name": "exampleblog.client.angular",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "run-script-os",
        "build": "ng build",
        "test": "ng test",
        "lint": "ng lint",
        "e2e": "ng e2e",
        "prestart": "node aspnetcore-https",
        "start:windows": "ng serve --ssl --ssl-cert \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.pem\" --ssl-key \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.key\" --host=127.0.0.1 --port %PORT%",
        "start:default": "ng serve --ssl --ssl-cert \"$HOME/.aspnet/https/${npm_package_name}.pem\" --ssl-key \"$HOME/.aspnet/https/${npm_package_name}.key\" --host=127.0.0.1 --port $PORT"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "22.0.8",
        "@angular/cdk": "22.0.6",
        "@angular/common": "22.0.8",
        "@angular/compiler": "22.0.8",
        "@angular/core": "22.0.8",
        "@angular/forms": "22.0.8",
        "@angular/platform-browser": "22.0.8",
        "@angular/platform-browser-dynamic": "22.0.8",
        "@angular/platform-server": "22.0.8",
        "@angular/router": "22.0.8",
        "@fortawesome/fontawesome-free": "7.3.1",
        "@odata/parser": "0.2.14",
        "@opentelemetry/api": "1.9.1",
